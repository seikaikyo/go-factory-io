{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "studio.dashai.dev" }],
      "destination": "https://studio.seikai.dev/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "studio.dashai.dev" }],
      "destination": "https://studio.seikai.dev/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
